# Cloudflare static-assets headers. Copied into out/ by `next build`, then
# extended by scripts/postbuild.mjs with a noindex rule for every RSC payload.
# https://developers.cloudflare.com/workers/static-assets/headers/

# The Worker also answers on garage.<account>.workers.dev (workers_dev: true),
# a full duplicate of the site. Keep that copy out of the index.
https://:project.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
